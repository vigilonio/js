{
  "branches": {
    "frames": [
      "mapped-a",
      "mapped-b"
    ],
    "fallback": [
      "unmapped"
    ]
  },
  "reasons": {
    "same-frames": "Different bugs whose contributing frames are identical: the same function calls the same helper from two lines.",
    "async-boundary": "Different bugs told apart only by a caller past an await, which not every engine keeps in the stack.",
    "message-only": "Different bugs on the fallback branch whose exception type and message are the same.",
    "engine-omits-value": "An engine leaves out of its message a value the other engines report, such as the property name of a computed access or whether a property was read or written.",
    "different-branch": "The same bug grouped on the frames branch in a source-mapped build and on the fallback branch in an unmapped one.",
    "stack-truncated": "The same bug, but one engine cut the stack short before the callers: Chromium keeps ten frames, so deep recursion leaves only the recursive function."
  },
  "bugs": {
