{
  "name": "@vigilon/nextjs",
  "version": "0.2.23",
  "description": "Vigilon monitoring for Next.js applications: server traces and browser errors",
  "license": "ISC",
  "author": "Vigilon",
  "homepage": "https://vigilon.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigilonio/js.git",
    "directory": "packages/nextjs"
  },
  "keywords": [
    "vigilon",
    "nextjs",
    "error-monitoring",
    "opentelemetry",
    "observability"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.cjs"
      }
    },
    "./register": {
      "import": "./register.mjs",
      "require": "./register.cjs",
      "default": "./register.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "register.mjs",
    "register.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@vigilon/cli": "workspace:*",
    "@vigilon/node": "workspace:*",
    "@vigilon/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^21.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
