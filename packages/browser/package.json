{
  "name": "@vigilon/browser",
  "version": "0.2.9",
  "description": "Vigilon error monitoring for browser applications",
  "license": "ISC",
  "author": "Vigilon",
  "homepage": "https://vigilon.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigilonio/js.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "vigilon",
    "error-monitoring",
    "browser",
    "javascript-errors",
    "observability"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vigilon.min.js",
  "jsdelivr": "./dist/vigilon.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:transport": "playwright test",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
